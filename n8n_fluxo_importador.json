{
  "name": "Importador de Contatos Chatwoot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "importar-contatos",
        "options": {
          "responseMode": "lastNode"
        }
      },
      "id": "webhook-entrada",
      "name": "Webhook Importar",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "importar-contatos"
    },
    {
      "parameters": {
        "jsCode": "// Recebe os dados do webhook\nconst input = $input.first().json;\n\n// Configurações do Chatwoot\nconst config = {\n  apiUrl: input.apiUrl,\n  accountId: input.accountId,\n  apiToken: input.apiToken,\n  inboxId: input.inboxId\n};\n\n// Kanban (opcional)\nconst kanban = input.kanban || null;\n\n// Contatos a importar\nconst contatos = input.contatos || [];\n\n// Retorna para próximo nó\nreturn {\n  config,\n  kanban,\n  contatos,\n  total: contatos.length,\n  processados: 0,\n  sucesso: 0,\n  erros: 0,\n  resultados: []\n};"
      },
      "id": "preparar-dados",
      "name": "Preparar Dados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-contatos",
      "name": "Split Contatos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Pega o contato atual e config\nconst data = $input.first().json;\nconst contato = data.contatos[data.processados];\nconst config = data.config;\n\nif (!contato) {\n  return { done: true, ...data };\n}\n\n// Formata telefone\nlet phone = contato.phone_number || '';\nif (phone) {\n  phone = String(phone).replace(/\\D/g, '');\n  if (phone.length === 10 || phone.length === 11) {\n    phone = '55' + phone;\n  }\n  if (!phone.startsWith('+')) {\n    phone = '+' + phone;\n  }\n}\n\n// Monta dados do contato\nconst contactData = {\n  inbox_id: parseInt(config.inboxId),\n  name: contato.name || '',\n  phone_number: phone,\n  email: contato.email || '',\n  identifier: contato.identifier || '',\n  custom_attributes: contato.custom_attributes || {}\n};\n\n// Remove campos vazios\nObject.keys(contactData).forEach(key => {\n  if (contactData[key] === '' || contactData[key] === null) {\n    delete contactData[key];\n  }\n});\n\nreturn {\n  ...data,\n  currentContact: contactData,\n  currentIndex: data.processados\n};"
      },
      "id": "processar-contato",
      "name": "Processar Contato",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.apiUrl }}/api/v1/accounts/{{ $json.config.accountId }}/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.currentContact) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "criar-contato",
      "name": "Criar Contato API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "chatwoot-token",
          "name": "Chatwoot Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = $('Processar Contato').first().json;\n\nlet resultado = {\n  index: data.currentIndex,\n  status: 'error',\n  message: 'Erro desconhecido',\n  contactId: null,\n  conversationId: null\n};\n\ntry {\n  if (input.statusCode === 200 || input.statusCode === 201) {\n    const body = input.body;\n    const contact = body.payload?.contact || body;\n    resultado = {\n      index: data.currentIndex,\n      status: 'success',\n      message: 'Contato criado',\n      contactId: contact.id,\n      sourceId: contact.contact_inboxes?.[0]?.source_id || null\n    };\n  } else {\n    resultado.message = input.body?.message || input.body?.error || 'Erro na API';\n  }\n} catch (e) {\n  resultado.message = e.message;\n}\n\nreturn {\n  ...data,\n  resultado,\n  processados: data.processados + 1,\n  sucesso: resultado.status === 'success' ? data.sucesso + 1 : data.sucesso,\n  erros: resultado.status === 'error' ? data.erros + 1 : data.erros,\n  resultados: [...data.resultados, resultado]\n};"
      },
      "id": "processar-resposta",
      "name": "Processar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "kanban-ativo",
              "leftValue": "={{ $json.kanban }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty"
              }
            },
            {
              "id": "contato-criado",
              "leftValue": "={{ $json.resultado.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "verificar-kanban",
      "name": "Kanban Ativo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.apiUrl }}/api/v1/accounts/{{ $json.config.accountId }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inbox_id: parseInt($json.config.inboxId), contact_id: $json.resultado.contactId, source_id: $json.resultado.sourceId || 'import_' + Date.now(), status: 'pending' }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "criar-conversa",
      "name": "Criar Conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1650, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "chatwoot-token",
          "name": "Chatwoot Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst data = $('Verificar Kanban?').first().json;\n\nlet conversationId = null;\n\ntry {\n  if (input.statusCode === 200 || input.statusCode === 201) {\n    conversationId = input.body?.id;\n  }\n} catch (e) {\n  console.log('Erro ao criar conversa:', e.message);\n}\n\nreturn {\n  ...data,\n  resultado: {\n    ...data.resultado,\n    conversationId\n  }\n};"
      },
      "id": "extrair-conversa-id",
      "name": "Extrair Conversa ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.config.apiUrl }}/api/v1/accounts/{{ $json.config.accountId }}/funnels/{{ $json.kanban.funnelId }}/kanban/move_conversation",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $json.resultado.conversationId, stage_name: $json.kanban.stageName }) }}",
        "options": {}
      },
      "id": "mover-kanban",
      "name": "Mover para Kanban",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2050, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "chatwoot-token",
          "name": "Chatwoot Token"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "mais-contatos",
              "leftValue": "={{ $json.processados }}",
              "rightValue": "={{ $json.total }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "mais-contatos",
      "name": "Mais Contatos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2250, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\nreturn {\n  success: true,\n  message: `Importação concluída: ${data.sucesso} sucesso, ${data.erros} erros de ${data.total} contatos`,\n  total: data.total,\n  sucesso: data.sucesso,\n  erros: data.erros,\n  resultados: data.resultados\n};"
      },
      "id": "resultado-final",
      "name": "Resultado Final",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2450, 400]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "merge-loop",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2250, 100]
    }
  ],
