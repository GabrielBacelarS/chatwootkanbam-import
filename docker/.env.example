# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# Debug mode
DEBUG=false

# PostgreSQL
POSTGRES_USER=closefy
POSTGRES_PASSWORD=sua-senha-postgres-aqui
POSTGRES_DB=closefydb

# Sessao (gerar com: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=gerar-um-segredo-aleatorio-aqui

# Admin
ADMIN_EMAIL=seu-email@example.com
ADMIN_PASSWORD=sua-senha-admin-aqui

# MinIO
MINIO_ACCESS_KEY=closefy
MINIO_SECRET_KEY=sua-senha-minio-aqui
