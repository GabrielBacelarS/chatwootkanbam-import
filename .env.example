# Configuracoes do servidor
PORT=3000
HOST=0.0.0.0
DEBUG=false

# Banco de dados PostgreSQL (OBRIGATORIO)
# Formato: postgresql+asyncpg://usuario:senha@host:porta/database
DATABASE_URL=postgresql+asyncpg://closefy:SUA_SENHA_AQUI@localhost:5432/closefydb

# Segredo para sessoes (OBRIGATORIO - gerar um valor aleatorio)
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=gerar-um-segredo-aleatorio-aqui

# Admin padrao
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=senha-segura-aqui

# Redis (para cache e sessoes)
REDIS_URL=redis://localhost:6379/0

# MinIO (armazenamento de arquivos)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=closefy
MINIO_SECRET_KEY=sua-senha-minio-aqui
MINIO_SECURE=false

# IA - Modo de deteccao de intencao
# Opcoes: keywords, auto, always
AI_INTENT_DETECTION_MODE=keywords
