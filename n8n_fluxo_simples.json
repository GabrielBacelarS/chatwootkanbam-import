{
  "name": "Importador Contatos Chatwoot - Simples",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "importar-contatos",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-1111-2222-3333-444455556666",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "importar-contatos-chatwoot"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "config",
              "name": "config",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-2222-3333-4444-555566667777",
      "name": "Extrair Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
    },
    {
      "parameters": {
        "jsCode": "const config = $input.first().json.config;\n\nconst results = [];\nconst contatos = config.contatos || [];\n\nfor (let i = 0; i < contatos.length; i++) {\n  const c = contatos[i];\n  \n  // Formata telefone\n  let phone = c.phone_number || '';\n  if (phone) {\n    phone = String(phone).replace(/\\D/g, '');\n    if (phone.length === 10 || phone.length === 11) {\n      phone = '55' + phone;\n    }\n    if (!phone.startsWith('+')) {\n      phone = '+' + phone;\n    }\n  }\n  \n  results.push({\n    apiUrl: config.apiUrl,\n    accountId: config.accountId,\n    apiToken: config.apiToken,\n    inboxId: config.inboxId,\n    kanban: config.kanban || null,\n    index: i,\n    total: contatos.length,\n    contact: {\n      inbox_id: parseInt(config.inboxId),\n      name: c.name || undefined,\n      phone_number: phone || undefined,\n      email: c.email || undefined,\n      identifier: c.identifier || undefined,\n      custom_attributes: c.custom_attributes || undefined\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "a1b2c3d4-3333-4444-5555-666677778888",
      "name": "Preparar Contatos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiUrl }}/api/v1/accounts/{{ $json.accountId }}/contacts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $json.apiToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.contact) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "a1b2c3d4-4444-5555-6666-777788889999",
      "name": "Criar Contato",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300],
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prev = $('Preparar Contatos').item;\n\nlet result = {\n  index: prev.json.index,\n  total: prev.json.total,\n  apiUrl: prev.json.apiUrl,\n  accountId: prev.json.accountId,\n  apiToken: prev.json.apiToken,\n  inboxId: prev.json.inboxId,\n  kanban: prev.json.kanban,\n  status: 'error',\n  contactId: null,\n  sourceId: null,\n  message: 'Erro'\n};\n\ntry {\n  if (input.statusCode === 200 || input.statusCode === 201) {\n    const contact = input.body?.payload?.contact || input.body;\n    result.status = 'success';\n    result.contactId = contact.id;\n    result.sourceId = contact.contact_inboxes?.[0]?.source_id;\n    result.message = 'OK';\n  } else {\n    result.message = JSON.stringify(input.body);\n  }\n} catch(e) {\n  result.message = e.message;\n}\n\nreturn result;"
      },
      "id": "a1b2c3d4-5555-6666-7777-888899990000",
      "name": "Processar Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "tem-kanban",
              "leftValue": "={{ $json.kanban }}",
              "rightValue": "",
              "operator": {
                "type": "object",
                "operation": "notEmpty"
              }
            },
            {
              "id": "sucesso",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1b2c3d4-6666-7777-8888-999900001111",
      "name": "Tem Kanban?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1300, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiUrl }}/api/v1/accounts/{{ $json.accountId }}/conversations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $json.apiToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inbox_id: parseInt($json.inboxId), contact_id: $json.contactId, source_id: $json.sourceId || ('import_' + Date.now() + '_' + $json.index), status: 'pending' }) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "a1b2c3d4-7777-8888-9999-000011112222",
      "name": "Criar Conversa",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1520, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst prev = $('Tem Kanban?').item;\n\nlet conversationId = null;\ntry {\n  if (input.statusCode === 200 || input.statusCode === 201) {\n    conversationId = input.body?.id;\n  }\n} catch(e) {}\n\nreturn {\n  ...prev.json,\n  conversationId\n};"
      },
      "id": "a1b2c3d4-8888-9999-0000-111122223333",
      "name": "Extrair Conversa",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1740, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.apiUrl }}/api/v1/accounts/{{ $json.accountId }}/funnels/{{ $json.kanban.funnelId }}/kanban/move_conversation",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api_access_token",
              "value": "={{ $json.apiToken }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ conversation_id: $json.conversationId, stage_name: $json.kanban.stageName }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-9999-0000-1111-222233334444",
      "name": "Mover Kanban",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1960, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "options": {}
      },
      "id": "a1b2c3d4-0000-1111-2222-333344445555",
      "name": "Agregar Resultados",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [2180, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.first().json.data || [];\n\nlet sucesso = 0;\nlet erros = 0;\nconst resultados = [];\n\nitems.forEach(item => {\n  if (item.status === 'success') sucesso++;\n  else erros++;\n  \n  resultados.push({\n    index: item.index,\n    status: item.status,\n    contactId: item.contactId,\n    conversationId: item.conversationId,\n    message: item.message\n  });\n});\n\nreturn {\n  success: true,\n  message: `Importação concluída: ${sucesso} sucesso, ${erros} erros`,\n  total: items.length,\n  sucesso,\n  erros,\n  resultados\n};"
      },
      "id": "a1b2c3d4-1111-2222-3333-444455556677",
      "name": "Montar Resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2400, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "a1b2c3d4-2222-3333-4444-555566667788",
      "name": "Responder Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2620, 300]
    }
  ],
